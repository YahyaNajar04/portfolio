---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path to an OG image in /public, e.g. "/og/covertype.png" */
  ogImage?: string;
}

const { title, description, ogImage = '/og/default.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class="wrap site-head">
      <a href="/" class="meta">Muhammed Yahya Najar</a>
      <nav class="meta">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="mailto:mynajar04@gmail.com">Email</a>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="wrap site-foot">
      <hr class="rule" />
      <p class="meta">
        &copy; {year} &middot;
        <a href="mailto:mynajar04@gmail.com">mynajar04@gmail.com</a> &middot;
        <a href="https://github.com/YahyaNajar04">GitHub</a> &middot;
        <a href="https://www.linkedin.com/in/yahya-najar">LinkedIn</a>
      </p>
    </footer>

    <script>
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-visible');
              io.unobserve(e.target);     // reveal once, then stop watching
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>