---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = ogImage ? new URL(ogImage, Astro.site) : null;
const year = new Date().getFullYear();

// logo-mark.svg, inlined so it can take currentColor on dark surfaces
const mark =
  "M95 230V95h41.8l52.2 87.3c28.8 47.9 52.8 88 53.5 88.9 1 1.5 8.7-11.1 53.5-87.2L348.3 95H390v270h-48V187.5l-43.8 73.2-43.7 73.2-23.1.1-43.4-71.5-43.5-71.5-.3 87L144 365H95V230Z";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      content="#f7f5ee"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111a15"
      media="(prefers-color-scheme: dark)"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    <meta
      name="twitter:card"
      content={og ? "summary_large_image" : "summary"}
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t) document.documentElement.dataset.theme = t;
        } catch (e) {}
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class="site-head">
      <div class="wrap">
        <a href="/" class="brand" aria-label="Muhammed Yahya Najar — home">
          <svg viewBox="0 0 485 460" width="24" height="23" aria-hidden="true">
            <path fill="currentColor" d={mark}></path>
          </svg>
          <span translate="no">Yahya Najar</span>
        </a>
        <nav aria-label="Primary">
          <a href="/#work">Work</a>
          <a href="/#experience">Experience</a>
          <a href="/#about">About</a>
        </nav>
        <a href="/#contact" class="btn btn-primary">Get in touch</a>
        <button
          id="theme-toggle"
          class="icon-btn"
          type="button"
          aria-label="Toggle dark mode"
        >
          <svg
            class="i-moon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path></svg
          >
          <svg
            class="i-sun"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path></svg
          >
        </button>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a href="/" class="brand">
              <svg
                viewBox="0 0 485 460"
                width="24"
                height="23"
                aria-hidden="true"
              >
                <path fill="currentColor" d={mark}></path>
              </svg>
              <span translate="no">Muhammed Yahya Najar</span>
            </a>
            <p>Software engineer. India &amp; Malaysia.</p>
          </div>
          <div>
            <h2>Site</h2>
            <ul class="plain">
              <li><a href="/work/">All work</a></li>
              <li><a href="/#experience">Experience</a></li>
              <li><a href="/Muhammed_Yahya_Najar_Resume_2026.pdf">Résumé (PDF)</a></li>
            </ul>
          </div>
          <div>
            <h2>Elsewhere</h2>
            <ul class="plain">
              <li><a href="mailto:mynajar04@gmail.com">Email</a></li>
              <li><a href="https://github.com/YahyaNajar04">GitHub</a></li>
              <li><a href="https://www.linkedin.com/in/yahya-najar">LinkedIn</a></li>
            </ul>
          </div>
        </div>
        <div class="foot-base">
          <span>&copy; {year} Muhammed Yahya Najar</span>
          <span>Built with Astro</span>
        </div>
      </div>
    </footer>

    <script>
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if (items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-visible");
              io.unobserve(e.target); // reveal once, then stop watching
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      }

      // hairline under the header only once the page has scrolled
      const head = document.querySelector(".site-head");
      const onScroll = () =>
        head?.classList.toggle("is-stuck", window.scrollY > 8);
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });
    </script>
    <script>
      const btn = document.getElementById("theme-toggle");
      const root = document.documentElement;
      const isDark = () =>
        root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
      const sync = () =>
        btn?.setAttribute("aria-pressed", String(isDark()));
      sync();
      btn?.addEventListener("click", () => {
        root.dataset.theme = isDark() ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch (e) {}
        sync();
      });
    </script>
  </body>
</html>
