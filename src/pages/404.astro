---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Muhammed Yahya Najar" description="That page doesn't exist.">
  <section class="wrap lost">
    <p class="eyebrow num">404</p>
    <h1>That page doesn’t exist.</h1>
    <p class="lede">The link may be old, or the project may have moved.</p>
    <p><a href="/" class="btn btn-primary">Back to home</a> <a href="/work/" class="btn btn-secondary">Browse work</a></p>
  </section>
</Base>

<style>
  .lost { padding-block: var(--s7); }
  .lost p:last-child { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s5); }
</style>
