---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Status from "../components/Status.astro";

const featured = (await getCollection("projects"))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Muhammed Yahya Najar — Software Engineer"
  description="Software engineer shipping production web, mobile and desktop systems, and building toward AI engineering."
>
  <!-- HERO ------------------------------------------------------------ -->
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="eyebrow avail">
        <span class="dot" aria-hidden="true"></span>
        Open to engineering roles &amp; client work
      </p>
      <h1>Production software, <em>honestly</em> measured.</h1>
      <p class="lede">
        I’m Yahya — a software engineer shipping web, mobile and desktop
        systems, now moving toward AI engineering. MSc in Artificial
        Intelligence, Asia Pacific University.
      </p>
      <div class="actions">
        <a href="#work" class="btn btn-primary">See the work</a>
        <a href="/Muhammed_Yahya_Najar_Resume_2026.pdf" class="btn btn-secondary"
          >Résumé (PDF)</a
        >
      </div>
    </div>

    <figure class="term" aria-label="projswitch printing a dry-run plan">
      <div class="term-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <b>pwsh — projswitch</b>
      </div>
      <pre><code><span class="p">❯</span> switch todotimer
<span class="c"># plan (dry run — nothing executes)</span>
<span class="n">1</span>  cd       <span class="s">D:\dev\todotimer</span>
<span class="n">2</span>  env      <span class="s">pnpm install --frozen-lockfile</span>
<span class="n">3</span>  editor   <span class="s">code .</span>
<span class="n">4</span>  start    <span class="s">pnpm tauri dev</span>

<span class="ok">✓</span> 4 steps · config <span class="s">todotimer.json</span>
<span class="p">❯</span> <span class="cursor"></span></code></pre>
      <figcaption>
        <a href="/work/projswitch/">projswitch</a> — plans first, runs later.
      </figcaption>
    </figure>
  </section>

  <!-- WORK ------------------------------------------------------------ -->
  <section class="band" id="work">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected work</h2>
        <a href="/work/" class="more">All projects →</a>
      </div>

      <ul class="plain cards">
        {
          featured.map((p) => {
            const m = p.data.metrics[1] ?? p.data.metrics[0];
            return (
              <li class="card reveal">
                <div class="card-top">
                  <span class="note num">{p.data.year}</span>
                  <Status status={p.data.status} />
                </div>
                <h3>
                  {p.data.writeup ? (
                    <a href={`/work/${p.id}/`} class="stretch">
                      {p.data.title}
                    </a>
                  ) : (
                    p.data.title
                  )}
                </h3>
                <p>{p.data.summary}</p>
                {m && (
                  <p class="metric">
                    <span class="num">{m.value}</span>
                    <span class="note">{m.label}</span>
                  </p>
                )}
                <ul class="plain stack">
                  {p.data.stack.slice(0, 3).map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
                {p.data.writeup && (
                  <span class="read" aria-hidden="true">
                    Read case study →
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- EXPERIENCE (dark band) ------------------------------------------ -->
  <section class="band dark" id="experience">
    <div class="wrap">
      <div class="section-head">
        <h2>Experience</h2>
      </div>
      <ol class="plain jobs">
        {
          experience.map((e) => (
            <li class="job reveal">
              <p class="when num">
                {e.data.start} – {e.data.end}
              </p>
              <div>
                <h3>{e.data.role}</h3>
                <p class="org">{e.data.org}</p>
                <ul class="points">
                  {e.data.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                {e.data.stack.length > 0 && (
                  <ul class="plain tags">
                    {e.data.stack.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ABOUT ----------------------------------------------------------- -->
  <section class="band" id="about">
    <div class="wrap about">
      <div>
        <h2>About</h2>
        <blockquote class="pull">
          “I’m a software engineer moving toward AI engineering, not someone
          claiming to have arrived.”
        </blockquote>
      </div>
      <div class="about-body">
        <p>
          I build production systems across web, mobile and desktop — most
          recently a retail inventory app in React Native and a cross-platform
          desktop time tracker in Tauri.
        </p>
        <p>
          My AI work so far is a hackathon claim-verification system and
          coursework-grade supervised learning. I’m honest about that. What I
          bring is shipping discipline — leakage-safe pipelines, measured
          results, and the willingness to say what a number actually means.
        </p>
        <dl class="facts">
          <div>
            <dt>MSc, Artificial Intelligence</dt>
            <dd>Asia Pacific University, Malaysia</dd>
          </div>
          <div>
            <dt>BSc, Software Engineering</dt>
            <dd>Asia Pacific University, Malaysia</dd>
          </div>
          <div>
            <dt>Based</dt>
            <dd>India &amp; Malaysia — remote or relocating</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- CONTACT (coral callout) ----------------------------------------- -->
  <section class="wrap contact-wrap" id="contact">
    <div class="callout">
      <h2>Let’s build something that works.</h2>
      <p>
        Open to engineering roles and to client work through Coderift. Based
        between India and Malaysia — remote or relocating.
      </p>
      <div class="actions">
        <a href="mailto:mynajar04@gmail.com" class="btn btn-cream"
          >mynajar04@gmail.com</a
        >
        <a href="https://www.linkedin.com/in/yahya-najar" class="btn btn-ghost"
          >LinkedIn</a
        >
        <a href="https://github.com/YahyaNajar04" class="btn btn-ghost">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- hero ------------------------------------------------ */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem) var(--s7);
  }
  .hero h1 em {
    font-style: italic;
    color: var(--accent-text);
  }
  .avail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    margin-bottom: var(--s4);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s5);
  }

  /* terminal / code-window card */
  .term {
    margin: 0;
    background: var(--dark);
    color: var(--on-dark);
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--hairline-dark);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.8rem 1rem;
    background: var(--dark-elevated);
  }
  .term-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #34483c;
  }
  .term-bar b {
    font: 500 0.75rem var(--font-mono);
    color: var(--on-dark-soft);
    margin-left: auto;
    margin-right: auto;
    transform: translateX(-15px);
  }
  .term pre {
    margin: 0;
    padding: 1.5rem;
    font: 0.875rem/1.75 var(--font-mono);
    overflow-x: auto;
    background: var(--dark-soft);
  }
  .term .p {
    color: var(--primary);
  }
  .term .c {
    color: #74806f;
  }
  .term .n {
    color: #5d6a5f;
  }
  .term .s {
    color: var(--amber);
  }
  .term .ok {
    color: var(--teal);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--on-dark-soft);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .term figcaption {
    padding: 0.8rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--on-dark-soft);
    border-top: 1px solid var(--hairline-dark);
  }
  .term figcaption a {
    color: var(--on-dark);
  }

  /* --- section heads --------------------------------------- */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s5);
  }
  .section-head h2 {
    margin: 0;
  }
  .more {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  /* --- work cards ------------------------------------------ */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s4);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface-card);
    border-radius: var(--r-lg);
    padding: var(--s5);
    transition: background-color 0.2s ease;
  }
  .card:has(.stretch):hover {
    background: var(--surface-strong);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s5);
  }
  .card-top :global(.pill) {
    background: var(--canvas);
  }
  .card h3 a {
    color: inherit;
    text-decoration: none;
  }
  .stretch::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .card p {
    margin: 0 0 var(--s4);
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: var(--s3);
    border-top: 1px solid var(--hairline);
  }
  .metric .num {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--s3);
  }
  .stack li {
    font-size: 0.8125rem;
    padding: 0.15rem 0.6rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--hairline);
    color: var(--muted);
    background: var(--canvas);
  }
  .read {
    margin-top: var(--s4);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--link);
  }

  /* --- experience (dark) ----------------------------------- */
  .dark {
    background: var(--dark);
    color: var(--on-dark-soft);
  }
  .dark h2,
  .dark h3 {
    color: var(--on-dark);
  }
  .jobs {
    border-top: 1px solid var(--hairline-dark);
  }
  .job {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--s5);
    padding-block: var(--s5);
    border-bottom: 1px solid var(--hairline-dark);
  }
  .when {
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
  }
  .job h3 {
    font-size: 1.5rem;
    margin: 0;
  }
  .org {
    margin: 0.2rem 0 var(--s3);
    color: var(--primary);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .points {
    margin: 0 0 var(--s3);
    padding-left: 1.1rem;
    color: var(--on-dark-body);
  }
  .points li {
    max-width: var(--measure);
    padding-block: 0.2rem;
  }
  .points li::marker {
    color: #4f6155;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags li {
    font-size: 0.8125rem;
    padding: 0.15rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--dark-elevated);
    color: var(--on-dark-soft);
  }

  /* --- about ----------------------------------------------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 6vw, 5rem);
  }
  .pull {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.3;
    color: var(--ink);
    padding-left: var(--s4);
    border-left: 2px solid var(--primary);
  }
  .about-body p {
    margin: 0 0 var(--s4);
    font-size: 1.0625rem;
  }
  .facts {
    margin: var(--s5) 0 0;
    border-top: 1px solid var(--hairline);
  }
  .facts div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: var(--s3);
    padding-block: var(--s3);
    border-bottom: 1px solid var(--hairline);
  }
  .facts dt {
    font-weight: 500;
    color: var(--ink);
  }
  .facts dd {
    margin: 0;
    color: var(--muted);
  }

  /* --- contact callout ------------------------------------- */
  .contact-wrap {
    padding-bottom: var(--s7);
  }
  .callout {
    background: var(--primary);
    color: var(--on-primary);
    border-radius: var(--r-lg);
    padding: clamp(2rem, 6vw, 4rem);
  }
  .callout h2 {
    color: var(--on-primary);
    margin-bottom: var(--s3);
  }
  .callout p {
    font-size: 1.125rem;
    margin: 0;
  }
  .btn-cream {
    background: var(--dark);
    color: #f3f1e8;
  }
  .btn-cream:hover {
    background: #0b120e;
    color: #f3f1e8;
  }
  .btn-ghost {
    color: var(--on-primary);
    border-color: rgb(20 26 22 / 0.4);
  }
  .btn-ghost:hover {
    color: var(--on-primary);
    border-color: var(--on-primary);
  }

  /* --- responsive ------------------------------------------ */
  @media (max-width: 1000px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .hero,
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .card {
      padding: var(--s4);
    }
    .job {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s2);
    }
    .facts div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
    .term pre {
      font-size: 0.8125rem;
      padding: 1.1rem;
    }
  }
</style>
