---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const featured = (await getCollection("projects"))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Muhammed Yahya Najar — Software Engineer"
  description="Software engineer shipping production web, mobile and desktop systems, and building toward AI engineering."
>
  <section class="wrap hero">
    <h1>Software engineer.<br />Building toward AI.</h1>
    <p class="lede">
      I ship production web, mobile and desktop systems. MSc in AI from APU
      Malaysia.
    </p>
    <p class="meta">
      <a href="mailto:mynajar04@gmail.com">mynajar04@gmail.com</a>
    </p>
  </section>

  <section class="wrap" id="work">
    <hr class="rule" />
    <h2 class="reveal">Selected work</h2>

    {
      featured.map((p, i) => (
        <article class="case reveal" style={`--delay:${i * 80}ms`}>
          <div class="rail">
            <span class="meta">{p.data.year}</span>
            {p.data.status !== "shipped" && (
              <span class="badge">{p.data.status}</span>
            )}
          </div>
          <div>
            <h3>
              {p.data.writeup ? (
                <a href={`/work/${p.id}/`}>{p.data.title}</a>
              ) : (
                p.data.title
              )}
            </h3>
            <p>{p.data.summary}</p>
            <p class="note">{p.data.role}</p>
            <p class="note stack">{p.data.stack.slice(0, 4).join(" · ")}</p>
          </div>
        </article>
      ))
    }

    <p class="meta more"><a href="/work/">All projects →</a></p>
  </section>

  <section class="wrap" id="experience">
    <hr class="rule" />
    <h2 class="reveal">Experience</h2>
    {
      experience.map((e, i) => (
        <article class="job reveal" style={`--delay:${i * 60}ms`}>
          <p class="meta">
            {e.data.start} — {e.data.end}
          </p>
          <div>
            <h3>
              {e.data.role} <span class="org">· {e.data.org}</span>
            </h3>
            <ul class="plain tight">
              {e.data.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            {e.data.stack.length > 0 && (
              <p class="meta">{e.data.stack.join(" · ")}</p>
            )}
          </div>
        </article>
      ))
    }
  </section>

  <section class="wrap" id="about">
    <hr class="rule" />
    <h2 class="reveal">About</h2>
    <div class="reveal about">
      <p>
        I build production systems across web, mobile and desktop — most
        recently a retail inventory app in React Native and a cross-platform
        desktop time tracker in Tauri. I hold an MSc in Artificial Intelligence
        and a BSc in Software Engineering from Asia Pacific University in
        Malaysia.
      </p>
      <p>
        My AI work so far is a hackathon claim-verification system and
        coursework-grade supervised learning. I'm honest about that: I'm a
        software engineer moving toward AI engineering, not someone claiming to
        have arrived. What I bring is shipping discipline — leakage-safe
        pipelines, measured results, and the willingness to say what a number
        actually means.
      </p>
      <p class="meta">
        <a href="/Muhammed_Yahya_Najar_Resume_2026.pdf">Download résumé (PDF)</a
        >
      </p>
    </div>
  </section>

  <section class="wrap" id="contact">
    <hr class="rule" />
    <h2 class="reveal">Contact</h2>
    <div class="reveal">
      <p class="contact-line">
        <a href="mailto:mynajar04@gmail.com">mynajar04@gmail.com</a>
      </p>
      <p>
        Open to senior engineering roles and to client work through Coderift.
        Based between India and Malaysia — remote or relocating.
      </p>
      <p class="meta contact-links">
        <a href="/Muhammed_Yahya_Najar_Resume_2026.pdf">Résumé (PDF)</a>
        <a href="https://github.com/YahyaNajar04">GitHub</a>
        <a href="https://www.linkedin.com/in/yahya-najar">LinkedIn</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* --- hero ------------------------------------------------ */
  .hero {
    padding-block: var(--s6) var(--s7);
  }
  .lede {
    font-size: 1.25rem;
    color: var(--muted);
    margin-bottom: var(--s4);
  }

  /* --- sections -------------------------------------------- */
  section {
    padding-block: var(--s7) 0;
  }
  section > .rule {
    margin-bottom: var(--s5);
  }

  /* --- featured work --------------------------------------- */
  .case {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--s5);
    padding-block: var(--s6);
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .case:last-of-type {
    border-bottom: 0;
  }
  .rail {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    align-items: flex-start;
    padding-top: 0.65rem;
  }
  .case h3 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin: 0 0 var(--s3);
  }
  .case h3 a {
    text-decoration: none;
  }
  .case h3 a:hover {
    color: var(--accent);
  }
  .case p {
    margin: 0 0 var(--s2);
  }
  .stack {
    color: var(--faint);
  }
  .more {
    margin-top: var(--s5);
  }

  /* --- experience ------------------------------------------ */
  .job {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--s5);
    padding-block: var(--s5);
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .job:last-of-type {
    border-bottom: 0;
  }
  .job h3 {
    font-size: 1.25rem;
    margin: 0 0 var(--s2);
  }
  .job .org {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--muted);
  }
  .job .plain li {
    padding-block: 0.2rem;
    max-width: var(--measure);
  }

  /* --- about / contact ------------------------------------- */
  .about p {
    margin-bottom: var(--s3);
  }
  .contact-line {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    margin-bottom: var(--s3);
  }
  .contact-links {
    display: flex;
    gap: var(--s4);
    flex-wrap: wrap;
    margin-top: var(--s4);
  }

  /* --- narrow ---------------------------------------------- */
  @media (max-width: 700px) {
    .case,
    .job {
      grid-template-columns: 1fr;
      gap: var(--s2);
    }
    .rail {
      flex-direction: row;
      align-items: center;
      gap: var(--s3);
      padding-top: 0;
    }
  }
</style>
