---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Status from '../../components/Status.astro';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order);
---
<Base title="Work — Muhammed Yahya Najar" description="Everything I've built — shipped products, client work, and research.">
  <section class="wrap archive">
    <p class="eyebrow"><a href="/">Home</a> / Work</p>
    <h1>Work</h1>
    <p class="lede">Everything, newest first. Most have a write-up.</p>

    <ul class="plain rows">
      {projects.map((p) => (
        <li class="row reveal">
          <span class="note num year">{p.data.year}</span>
          <div class="body">
            <h2>
              {p.data.writeup
                ? <a href={`/work/${p.id}/`} class="stretch">{p.data.title}</a>
                : p.data.title}
            </h2>
            <p>{p.data.summary}</p>
            <p class="note">{p.data.stack.join(' · ')}</p>
          </div>
          <div class="side">
            <Status status={p.data.status} />
            {p.data.writeup && <span class="arrow" aria-hidden="true">→</span>}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .archive { padding-block: var(--s6) var(--s7); }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { color: var(--ink); }
  .rows { margin-top: var(--s6); border-top: 1px solid var(--hairline); }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    gap: var(--s4);
    padding: var(--s5) var(--s3);
    margin-inline: calc(var(--s3) * -1);
    border-bottom: 1px solid var(--hairline);
    border-radius: var(--r-md);
    transition: background-color 0.15s ease;
  }
  .row:has(.stretch):hover { background: var(--surface-soft); }
  .year { padding-top: 0.45rem; }
  .row h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    letter-spacing: -0.01em;
    margin: 0 0 var(--s1);
  }
  .row h2 a { color: inherit; text-decoration: none; }
  .stretch::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .row p { margin: 0 0 var(--s1); }
  .side { display: flex; flex-direction: column; align-items: flex-end; gap: var(--s3); padding-top: 0.3rem; }
  .arrow { color: var(--link); font-size: 1.25rem; transition: transform 0.15s ease; }
  .row:hover .arrow { transform: translateX(3px); }
  @media (max-width: 700px) {
    .row { grid-template-columns: minmax(0, 1fr); gap: var(--s2); }
    .year { padding-top: 0; }
    .side { flex-direction: row; align-items: center; justify-content: space-between; order: -1; padding-top: 0; }
    .year { order: -2; }
  }
</style>
